# =============================================================================
# Frontend environment template
#
#   cp frontend/.env.example frontend/.env
#
# `.env` is gitignored (see .gitignore). Never commit real credentials.
#
# Full walkthrough:  docs/frontend-setup.md
# Authoritative list: architecture.md section 7.1
#
# SECURITY WARNING
# Every `VITE_*` variable is INLINED INTO THE SHIPPED JAVASCRIPT BUNDLE at build
# time, so it is public by definition. Only ever put the Supabase *anon /
# publishable* key here.
#
# Never put these in a VITE_-prefixed variable:
#   - DATABASE_URL
#   - SUPABASE_JWT_SECRET
#   - the Supabase service_role / secret key
# =============================================================================

# Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Same page -> Project API keys -> the *anon* / *publishable* key.
# This key is designed to be public. It is used here only for Supabase Auth.
# All data access goes through the FastAPI backend (PRD section 1), which is why
# anon-key access to the app's tables is not required.
VITE_SUPABASE_ANON_KEY=<your-anon-or-publishable-key>

# Base URL of the FastAPI backend. No trailing slash.
# Must be one of the origins listed in the backend's CORS_ORIGINS.
VITE_API_BASE_URL=http://localhost:8000
