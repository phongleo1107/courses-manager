# =============================================================================
# Backend environment template
#
#   cp backend/.env.example backend/.env
#
# `.env` is gitignored (see .gitignore: `.env`, `.env.*`, negated by
# `!.env.example`). Never commit real credentials.
#
# Full walkthrough:  docs/backend-setup.md
# Authoritative list: architecture.md section 7.1
# =============================================================================

# --- Database (Supabase Postgres) --------------------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
#
# Use the SQLAlchemy driver prefix `postgresql+psycopg://`, NOT the bare
# `postgresql://` string the dashboard gives you verbatim.
# Replace the password placeholder with your real database password.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Auth -----------------------------------------------------------
# Dashboard -> Project Settings -> API -> Project URL
# Used to build the expected `iss` claim check (architecture.md section 2.2).
SUPABASE_URL=https://<project-ref>.supabase.co

# Public keys used to verify tokens offline (ADR-3).
# Optional: defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# Per Supabase docs this URL is exactly the `iss` claim + /.well-known/jwks.json
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Expected `aud` claim on user access tokens. Normally `authenticated`.
# A `service_role` token must not be accepted on user-facing routes.
SUPABASE_JWT_AUDIENCE=authenticated

# --- Legacy shared secret (HS256 projects ONLY) ------------------------------
# LEAVE THIS COMMENTED OUT. New Supabase projects use asymmetric signing keys
# (ES256/RS256) verified via the JWKS URL above, which is the recommended setup.
#
# Only uncomment this if `docs/supabase-setup.md` step 3 found `alg: HS256`.
# Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
# This value is a SECRET: it must never be committed and never be exposed to the
# browser (never give it a VITE_ prefix).
# SUPABASE_JWT_SECRET=<your-legacy-jwt-secret>

# --- CORS --------------------------------------------------------------------
# Comma-separated allowlist of browser origins. Do NOT use a wildcard: the
# middleware also sets allow_credentials, and `*` is incompatible with it.
# Must match the frontend origin exactly, including scheme and port.
# See docs/frontend-setup.md for the frontend side of this.
CORS_ORIGINS=http://localhost:5173
